# Copy to .env.local and add your keys there.
# Restart npm run dev after changing values.

# Private AI key: use only in server-side code, never in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=

# Browser-visible key for the embedded Desmos calculator.
NEXT_PUBLIC_DESMOS_API_KEY=

# Supabase project URL and PUBLIC publishable key (Project Settings > API keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PRIVATE Supabase secret key. Never prefix this with NEXT_PUBLIC_.
# A legacy service_role key can instead be provided as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Used for email confirmation/recovery redirects. Set your HTTPS origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: image-capable model with structured-output support.
OPENAI_MODEL=gpt-5-mini

# Optional: minimal, low, medium, or high. Low is the speed/quality default;
# minimal is about twice as fast but produced wrong answers in testing.
OPENAI_REASONING_EFFORT=low

# Optional: priority (default) or default. Priority processing roughly halves
# solve time for about 1.8x the token price (~1 cent per solve). The server
# falls back automatically if the OpenAI project cannot use priority.
OPENAI_SERVICE_TIER=priority

# Spend protection (read on every request; no restart needed where the host
# applies env changes live). New solves per user per rolling 24 hours, and the
# total recorded OpenAI cost across all users per UTC day. Cached solves,
# history, and method switching on solved problems are never blocked.
FREE_SOLVES_PER_DAY=15
DAILY_SPEND_CEILING_USD=5
# Tutor ("Explain this") answers per user per rolling 24 hours, counted apart
# from solves; the tutor also stops at the spend ceiling above.
TUTOR_QUESTIONS_PER_DAY=40

# OpenAI call timeouts in ms (each call is aborted past these). A candidate
# timeout may be retried once when the route and spend budgets allow it.
# Hard image solves can exceed 20 s. Production enforces a 60 s minimum even
# if an older deployment still sets 20000. Every call also stops at the route's
# maxDuration (minus 5 s), so no value can outlive the function.
CANDIDATES_TIMEOUT_MS=60000
EXPLANATION_TIMEOUT_MS=30000

# Upload size limit in bytes (default 8 MB). Checked before anything is sent
# to OpenAI. On Vercel the platform refuses request bodies over 4.5 MB first.
# Images over 1600 px on the long edge are downscaled before sending.
MAX_IMAGE_BYTES=8388608
